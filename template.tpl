const addConsentListener = require('addConsentListener');
const callInWindow = require('callInWindow');
const copyFromWindow = require('copyFromWindow');
const createArgumentsQueue = require('createArgumentsQueue');
const getType = require('getType');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const logToConsole = require('logToConsole');
const makeInteger = require('makeInteger');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const templateStorage = require('templateStorage');

const TEMPLATE_VERSION = '1.0.0';
const SCRIPT_BASE_URL = 'https://cdn.pixelary.app/s/';
const CACHE_TOKEN_PREFIX = 'pixelary_';
const SITE_KEY_PREFIX = 'px_';
const SITE_KEY_CHARS = 'abcdefghijklmnopqrstuvwxyz0123456789';
const CURRENCY_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const CUSTOM_EVENT = '__custom';
const KEEP_CONSENT = 'keep';

const CONSENT_TYPES = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage'];

const MANUAL_CONSENT_FIELDS = [
  {param: 'consentAdStorage', type: 'ad_storage'},
  {param: 'consentAdUserData', type: 'ad_user_data'},
  {param: 'consentAdPersonalization', type: 'ad_personalization'},
  {param: 'consentAnalyticsStorage', type: 'analytics_storage'}
];

const USER_FIELDS = [
  {param: 'userEmail', key: 'email'},
  {param: 'userPhone', key: 'phone'},
  {param: 'userFirstName', key: 'first_name'},
  {param: 'userLastName', key: 'last_name'},
  {param: 'userExternalId', key: 'external_id'},
  {param: 'userCity', key: 'city'},
  {param: 'userZip', key: 'zip'},
  {param: 'userCountry', key: 'country'}
];

// templateStorage keys: shared by every Pixelary tag on the page.
const STORAGE_SOURCE_SENT = 'sourceSent';
const STORAGE_LISTENER_ADDED = 'consentListenerAdded';
const STORAGE_LAST_CONSENT = 'lastConsentModeState';

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// logToConsole only prints in Preview / Debug mode (logging permission).
const log = (message) => {
  logToConsole('[Pixelary] ' + message);
};

const fail = (message) => {
  log(message);
  data.gtmOnFailure();
};

const hasValue = (value) => {
  if (value === undefined || value === null) {
    return false;
  }
  return makeString(value).trim() !== '';
};

const cleanString = (value) => {
  return hasValue(value) ? makeString(value).trim() : undefined;
};

const isFiniteNumber = (value) => {
  return getType(value) === 'number' && value === value &&
    value !== 1 / 0 && value !== -1 / 0;
};

// Returns undefined when empty, null when invalid, otherwise a number.
// Accepts numbers and numeric strings; a comma decimal separator ("19,99") is
// accepted too.
const parseNumber = (value) => {
  if (!hasValue(value)) {
    return undefined;
  }
  let result = makeNumber(value);
  if (!isFiniteNumber(result) && getType(value) === 'string') {
    result = makeNumber(value.trim().split(',').join('.'));
  }
  return isFiniteNumber(result) ? result : null;
};

// Returns undefined when empty, null when invalid, otherwise an upper-case
// three-letter code.
const parseCurrency = (value) => {
  const text = cleanString(value);
  if (text === undefined) {
    return undefined;
  }
  const code = text.toUpperCase();
  if (code.length !== 3) {
    return null;
  }
  for (let i = 0; i < code.length; i += 1) {
    if (CURRENCY_CHARS.indexOf(code.charAt(i)) === -1) {
      return null;
    }
  }
  return code;
};

// Accepts "a, b, c", a single ID, an array of IDs, or an array of GA4 items
// (uses item_id, then id).
const parseContentIds = (value) => {
  if (value === undefined || value === null) {
    return undefined;
  }
  const type = getType(value);
  let items;
  if (type === 'array') {
    items = value;
  } else if (type === 'string') {
    items = value.split(',');
  } else {
    items = [value];
  }
  const ids = [];
  items.forEach((item) => {
    let id = item;
    if (getType(item) === 'object') {
      id = hasValue(item.item_id) ? item.item_id : item.id;
    }
    const text = getType(id) === 'object' ? undefined : cleanString(id);
    if (text !== undefined) {
      ids.push(text);
    }
  });
  return ids.length > 0 ? ids : undefined;
};

const isValidSiteKey = (key) => {
  if (getType(key) !== 'string' || key.indexOf(SITE_KEY_PREFIX) !== 0) {
    return false;
  }
  const rest = key.substring(SITE_KEY_PREFIX.length);
  if (rest.length < 5 || rest.length > 12) {
    return false;
  }
  for (let i = 0; i < rest.length; i += 1) {
    if (SITE_KEY_CHARS.indexOf(rest.charAt(i)) === -1) {
      return false;
    }
  }
  return true;
};

const normalizeConsentValue = (value) => {
  if (value === true) {
    return 'granted';
  }
  if (value === false) {
    return 'denied';
  }
  const text = cleanString(value);
  if (text === undefined) {
    return undefined;
  }
  const lower = text.toLowerCase();
  if (lower === 'granted' || lower === 'true' || lower === 'yes' || lower === '1') {
    return 'granted';
  }
  if (lower === 'denied' || lower === 'false' || lower === 'no' || lower === '0') {
    return 'denied';
  }
  return undefined;
};

// ---------------------------------------------------------------------------
// Command queue
// ---------------------------------------------------------------------------

// Sends one command to window.pixelary. If the function exists (the queue
// stub or the loaded SDK) it is called directly; otherwise the stub is created
// with createArgumentsQueue, which pushes each call's arguments onto
// window.pixelary.q for the SDK to drain when it loads. The window is checked
// on every call, so callbacks that run later (consent listeners) always reach
// the current function.
const send = (command, arg1, arg2, arg3) => {
  if (getType(copyFromWindow('pixelary')) === 'function') {
    if (arg3 !== undefined) {
      callInWindow('pixelary', command, arg1, arg2, arg3);
    } else if (arg2 !== undefined) {
      callInWindow('pixelary', command, arg1, arg2);
    } else if (arg1 !== undefined) {
      callInWindow('pixelary', command, arg1);
    } else {
      callInWindow('pixelary', command);
    }
    return;
  }
  const pixelary = createArgumentsQueue('pixelary', 'pixelary.q');
  if (arg3 !== undefined) {
    pixelary(command, arg1, arg2, arg3);
  } else if (arg2 !== undefined) {
    pixelary(command, arg1, arg2);
  } else if (arg1 !== undefined) {
    pixelary(command, arg1);
  } else {
    pixelary(command);
  }
};

// ---------------------------------------------------------------------------
// Google Consent Mode
// ---------------------------------------------------------------------------

const readConsentModeState = () => {
  const state = {};
  CONSENT_TYPES.forEach((type) => {
    state[type] = isConsentGranted(type) ? 'granted' : 'denied';
  });
  return state;
};

const consentStateKey = (state) => {
  return CONSENT_TYPES.map((type) => type + '=' + state[type]).join('&');
};

// Sends the current Consent Mode state unless this page already sent exactly
// the same state from this template (several listeners fire for one update).
const sendConsentModeState = () => {
  const state = readConsentModeState();
  const key = consentStateKey(state);
  if (templateStorage.getItem(STORAGE_LAST_CONSENT) === key) {
    return;
  }
  templateStorage.setItem(STORAGE_LAST_CONSENT, key);
  send('consent', state, {source: 'gtm'});
};

// One set of listeners per page, however many Pixelary tags fire.
const ensureConsentListeners = () => {
  if (templateStorage.getItem(STORAGE_LISTENER_ADDED)) {
    return;
  }
  templateStorage.setItem(STORAGE_LISTENER_ADDED, true);
  CONSENT_TYPES.forEach((type) => {
    addConsentListener(type, () => {
      sendConsentModeState();
    });
  });
};

// ---------------------------------------------------------------------------
// Payload builders
// ---------------------------------------------------------------------------

const buildUser = () => {
  const user = {};
  let count = 0;
  USER_FIELDS.forEach((field) => {
    const value = cleanString(data[field.param]);
    if (value !== undefined) {
      user[field.key] = value;
      count += 1;
    }
  });
  return count > 0 ? user : undefined;
};

const resolveEventName = () => {
  if (data.eventName === CUSTOM_EVENT) {
    return cleanString(data.customEventName);
  }
  return cleanString(data.eventName);
};

const setString = (target, key, value) => {
  const text = cleanString(value);
  if (text !== undefined) {
    target[key] = text;
  }
};

const buildEventData = () => {
  const eventData = {};

  // Custom parameters first, so the dedicated fields below win on conflicts.
  const rows = data.customParams || [];
  rows.forEach((row) => {
    const name = cleanString(row.paramName);
    if (name !== undefined && hasValue(row.paramValue)) {
      eventData[name] = row.paramValue;
    }
  });

  const value = parseNumber(data.value);
  if (value === null) {
    log('Value "' + makeString(data.value) + '" is not a number, so it was not sent.');
  } else if (value !== undefined) {
    eventData.value = value;
  }

  const currency = parseCurrency(data.currency);
  if (currency === null) {
    log('Currency "' + makeString(data.currency) + '" is not a three-letter ISO 4217 code, so it was not sent.');
  } else if (currency !== undefined) {
    eventData.currency = currency;
  }

  const contentIds = parseContentIds(data.contentIds);
  if (contentIds !== undefined) {
    eventData.content_ids = contentIds;
  }

  setString(eventData, 'content_type', data.contentType);
  setString(eventData, 'content_name', data.contentName);

  const numItems = parseNumber(data.numItems);
  if (numItems === null) {
    log('Number of items "' + makeString(data.numItems) + '" is not a number, so it was not sent.');
  } else if (numItems !== undefined) {
    eventData.num_items = makeInteger(numItems);
  }

  setString(eventData, 'order_id', data.orderId);
  return eventData;
};

const buildEventOptions = () => {
  const options = {};
  const eventId = cleanString(data.eventId);
  if (eventId !== undefined) {
    options.event_id = eventId;
  }
  const user = buildUser();
  if (user !== undefined) {
    options.user = user;
  }
  return options;
};

const buildManualConsentState = () => {
  const state = {};
  let count = 0;
  MANUAL_CONSENT_FIELDS.forEach((field) => {
    const raw = data[field.param];
    if (raw === KEEP_CONSENT) {
      return;
    }
    const value = normalizeConsentValue(raw);
    if (value !== undefined) {
      state[field.type] = value;
      count += 1;
    } else if (hasValue(raw)) {
      log(field.type + ' value "' + makeString(raw) + '" is not granted or denied, so it was not sent.');
    }
  });
  return count > 0 ? state : undefined;
};

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

const action = data.action || 'load';
if (action !== 'load' && action !== 'track' && action !== 'identify' && action !== 'consent') {
  return fail('Unknown action "' + makeString(action) + '".');
}

// Validate everything before touching the page.
const siteKey = cleanString(action === 'load' ? data.siteKey : data.optionalSiteKey);
if (action === 'load' || siteKey !== undefined) {
  if (!isValidSiteKey(siteKey)) {
    return fail('Site key "' + (siteKey === undefined ? '' : siteKey) + '" is not valid. It must be px_ followed by 5 to 12 lowercase letters or digits.');
  }
}

let eventName;
if (action === 'track') {
  eventName = resolveEventName();
  if (eventName === undefined) {
    return fail('Event name is empty. Choose an event or enter a custom event name.');
  }
}

let manualConsent;
if (action === 'consent') {
  manualConsent = buildManualConsentState();
  if (manualConsent === undefined) {
    return fail('Update consent has nothing to send. Set at least one consent type to granted or denied.');
  }
}

// 1. Install source, once per page.
if (!templateStorage.getItem(STORAGE_SOURCE_SENT)) {
  templateStorage.setItem(STORAGE_SOURCE_SENT, true);
  send('source', 'gtm', {template_version: TEMPLATE_VERSION});
}

// 2. SDK settings (base tag only).
if (action === 'load' && data.disableAutoEvents === true) {
  send('config', {auto_events: false});
}

// 3. Consent before the event it applies to.
if (action !== 'consent' && data.passConsentMode !== false) {
  sendConsentModeState();
  ensureConsentListeners();
}

// 4. The action itself.
if (action === 'track') {
  send('track', eventName, buildEventData(), buildEventOptions());
} else if (action === 'identify') {
  const user = buildUser();
  if (user !== undefined) {
    send('identify', user);
  } else {
    log('Identify user skipped: every user data field is empty on this page.');
  }
} else if (action === 'consent') {
  send('consent', manualConsent, {source: 'gtm'});
}

// 5. Load the SDK (one script element per page and site key) or finish.
if (siteKey !== undefined) {
  const scriptUrl = SCRIPT_BASE_URL + siteKey + '.js';
  injectScript(scriptUrl, data.gtmOnSuccess, () => {
    fail('Could not load ' + scriptUrl + '. An ad blocker or a Content Security Policy may be blocking it.');
  }, CACHE_TOKEN_PREFIX + siteKey);
} else {
  data.gtmOnSuccess();
}


