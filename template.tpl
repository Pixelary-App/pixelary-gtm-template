setup: |-
  // Commands that reached window.pixelary, as [command, arg1, arg2, ...].
  let commands = [];
  const commandsNamed = (name) => commands.filter((c) => c[0] === name);

  // Simulated window: createArgumentsQueue creates window.pixelary.
  let windowData = {};
  mock('copyFromWindow', (key) => windowData[key]);
  mock('createArgumentsQueue', (fnKey, arrayKey) => {
    assertThat(fnKey).isEqualTo('pixelary');
    assertThat(arrayKey).isEqualTo('pixelary.q');
    const stub = function() {
      const args = [];
      for (let i = 0; i < arguments.length; i++) {
        args.push(arguments[i]);
      }
      commands.push(args);
    };
    windowData.pixelary = stub;
    return stub;
  });
  mock('callInWindow', function() {
    assertThat(arguments[0]).isEqualTo('pixelary');
    const args = [];
    for (let i = 1; i < arguments.length; i++) {
      args.push(arguments[i]);
    }
    commands.push(args);
  });

  // injectScript runs synchronously here; in the browser it is async.
  let injected = [];
  let injectShouldFail = false;
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injected.push({url: url, cacheToken: cacheToken});
    if (injectShouldFail) {
      onFailure();
    } else {
      onSuccess();
    }
  });

  // Google Consent Mode.
  const allGranted = {
    ad_storage: 'granted',
    ad_user_data: 'granted',
    ad_personalization: 'granted',
    analytics_storage: 'granted'
  };
  let consentState = allGranted;
  let consentListeners = [];
  mock('isConsentGranted', (type) => consentState[type] === 'granted');
  mock('addConsentListener', (type, listener) => {
    consentListeners.push({type: type, listener: listener});
  });

  // Template storage lives for the page, so it is shared between runCode calls.
  let storage = {};
  mockObject('templateStorage', {
    getItem: (key) => storage[key],
    setItem: (key, value) => {
